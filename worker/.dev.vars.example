# Copy to worker/.dev.vars for local wrangler dev (never commit .dev.vars).
# Frontend does not use these — only the Worker API.

# Required for Supabase-backed auth / assets / object types
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT signing for API sessions (use a long random string in real environments)
JWT_SECRET=replace-with-a-long-random-secret

# Google Sheets OAuth (Web client). Leave blank until a client exists;
# the Assets page then shows that the integration is not configured.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Callback the browser hits. Local Vite proxy:
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/google-sheets/callback
