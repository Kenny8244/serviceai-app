  const getPriorityColor = (priority: string) => {
    switch (priority) {
      case 'urgent': return 'bg-red-100 text-red-800'
      case 'high': return 'bg-orange-100 text-orange-800'
      case 'medium': return 'bg-yellow-100 text-yellow-800'
      default: return 'bg-green-100 text-green-800'
    }
  }

  // AI Routing Algorithm
  const analyzeTicketForRouting = (ticket: ServiceTicket) => {
    const availableMembers = teamMembers.filter(member =>
      member.status === 'online' && member.role !== 'guest'
    )

    // Extract keywords from ticket title and content
    const ticketContent = `${ticket.title} ${ticket.lastMessage}`.toLowerCase()
    const keywords = ticketContent.match(/\b\w+\b/g) || []

    // Score each team member based on various factors
    const scoredMembers = availableMembers.map(member => {
      let score = 0

      // Expertise matching (40% weight)
      const expertiseMatch = member.expertise.filter(exp =>
        keywords.some(keyword => exp.toLowerCase().includes(keyword) || keyword.includes(exp.toLowerCase()))
      ).length
      score += (expertiseMatch / member.expertise.length) * 40

      // Workload factor (30% weight) - prefer members with lighter workload
      const workloadScore = Math.max(0, 30 - member.workload)
      score += workloadScore

      // Performance factor (20% weight) - based on past performance
      const performanceScore = (member.stats.satisfaction / 5) * 20
      score += performanceScore

      // Availability factor (10% weight) - prefer currently online members
      const availabilityScore = member.status === 'online' ? 10 : 5
      score += availabilityScore

      return { member, score }
    })

    // Sort by score and return top recommendation
    scoredMembers.sort((a, b) => b.score - a.score)
    return scoredMembers[0] || null
  }

  // Predictive Maintenance Algorithm
  const analyzeMaintenancePatterns = () => {
    const maintenanceAlerts = []

    // Analyze service ticket patterns to predict maintenance needs
    const recentTickets = serviceTickets.filter(ticket =>
      ticket.createdAt > new Date(Date.now() - 7 * 24 * 60 * 60 * 1000) // Last 7 days
    )

    // Pattern 1: High priority tickets indicate potential system issues
    const highPriorityTickets = recentTickets.filter(ticket => ticket.priority === 'high' || ticket.priority === 'urgent')
    if (highPriorityTickets.length > 3) {
      maintenanceAlerts.push({
        id: '1',
        type: 'system_health',
        title: 'Potential System Health Issues',
        description: `${highPriorityTickets.length} high-priority tickets in the last week suggest potential system instability.`,
        urgency: 'high',
        predictedDate: new Date(Date.now() + 2 * 24 * 60 * 60 * 1000),
        confidence: 85,
        recommendations: [
          'Schedule system health check',
          'Review error logs for patterns',
          'Consider proactive maintenance window'
        ]
      })
    }

    // Pattern 2: Similar ticket patterns indicate recurring issues
    const ticketKeywords = recentTickets.flatMap(ticket =>
      `${ticket.title} ${ticket.lastMessage}`.toLowerCase().split(' ')
    )

    const commonIssues = ticketKeywords.reduce((acc: Record<string, number>, keyword) => {
      if (keyword.length > 4) { // Filter out common words
        acc[keyword] = (acc[keyword] || 0) + 1
      }
      return acc
    }, {})

    Object.entries(commonIssues)
      .filter(([_, count]) => count > 2)
      .forEach(([issue, count]) => {
        maintenanceAlerts.push({
          id: `2_${issue}`,
          type: 'recurring_issue',
          title: `Recurring "${issue}" Issues`,
          description: `Detected ${count} instances of "${issue}" related issues in recent tickets.`,
          urgency: 'medium',
          predictedDate: new Date(Date.now() + 4 * 24 * 60 * 60 * 1000),
          confidence: 70,
          recommendations: [
            `Investigate root cause of ${issue} problems`,
            'Create preventive measures',
            'Update knowledge base with solution'
          ]
        })
      })

    // Pattern 3: Team performance trends
    const avgResponseTime = teamMembers.reduce((sum, member) => {
      const timeStr = member.stats.avgResponseTime
      const hours = parseFloat(timeStr.replace('h', ''))
      return sum + hours
    }, 0) / teamMembers.length

    if (avgResponseTime > 4) {
      maintenanceAlerts.push({
        id: '3',
        type: 'team_efficiency',
        title: 'Team Efficiency Optimization',
        description: `Average response time of ${avgResponseTime.toFixed(1)}h suggests potential workflow improvements.`,
        urgency: 'medium',
        predictedDate: new Date(Date.now() + 3 * 24 * 60 * 60 * 1000),
        confidence: 75,
        recommendations: [
          'Review team workload distribution',
          'Identify process bottlenecks',
          'Consider additional training or resources'
        ]
      })
    }

    return maintenanceAlerts
  }

  const maintenanceAlerts = analyzeMaintenancePatterns()

  const getUrgencyColor = (urgency: string) => {
    switch (urgency) {
      case 'high': return 'bg-red-100 text-red-800'
      case 'medium': return 'bg-yellow-100 text-yellow-800'
