interface TeamMember {
  id: string
  name: string
  email: string
  role: 'admin' | 'manager' | 'agent' | 'guest'
  avatar?: string
  status: 'online' | 'offline' | 'away'
  lastActive: Date
  joinDate: Date
  permissions: string[]
  expertise: string[] // Areas of expertise
  workload: number // Current ticket load (0-100)
  stats: {
    ticketsResolved: number
    avgResponseTime: string
    satisfaction: number
  }
}

interface ServiceTicket {
  id: string
  title: string
  status: 'open' | 'in_progress' | 'resolved' | 'closed'
  priority: 'low' | 'medium' | 'high' | 'urgent'
  assignee: string
  createdBy: string
  createdAt: Date
  updatedAt: Date
  messages: number
  lastMessage: string
}

